TAVILY_API_KEY=your_tavily_key_here
GROQ_API_KEY=your_groq_key_here

# Ignored when running via `docker compose up` — the backend service
# overrides this to point at the compose postgres container instead.
# Only used if you run the backend outside Docker.
DATABASE_URL=postgresql://gigscanner:gigscanner@localhost:5432/gigscanner
